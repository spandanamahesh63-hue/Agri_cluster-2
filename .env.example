# Copy to .env.local (local development) or set in Netlify → Site configuration →
# Environment variables. Leave everything unset and the app saves in the browser only.

# ---- Option A: MongoDB Atlas (through netlify/functions/api.mts) ----
# Pick MongoDB for the app:
VITE_DATABASE=mongodb
# Server-side only (no VITE_ prefix, so it never reaches the browser). From Atlas →
# your cluster → Connect → Drivers. Put your database user's password in it.
MONGODB_URI=mongodb+srv://agricluster:<password>@your-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Optional: database name (default "agricluster").
# MONGODB_DB=agricluster

# ---- Option B: Supabase ----
# Use the Project URL and the PUBLIC key (anon / publishable) from Supabase →
# Project Settings → API. Never put the service_role / secret key here.
# VITE_DATABASE=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
